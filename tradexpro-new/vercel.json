{
  "$schema": "https://vercel.com/api/v1/config.json",
  "version": 2,
  "buildCommand": "python -m compileall -q app.py api",
  "installCommand": "pip install -r requirements.txt",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.14",
      "includeFiles": [
        "app.py",
        "templates/**",
        "static/**",
        "api/**"
      ]
    }
  }
}
